# ===== 사용자 친화적인 주소 (Apache mod_rewrite) =====
# 주소 바꾸기 규칙을 켠다 (XAMPP 의 mod_rewrite 를 쓴다)
RewriteEngine On

# inc 폴더(공통 PHP 조각)는 주소로 직접 열 수 없게 막는다
# /inc/db.php, /inc/header.php 처럼 inc/ 로 시작하면 [F] 403 금지로 끝낸다
RewriteRule ^inc/ - [F]

# 실제로 있는 파일·폴더(css, images, index.php ...)는 그대로 보여 준다
# - 는 주소를 바꾸지 않는다는 뜻이고 [L] 은 규칙을 여기서 끝낸다
# / 는 폴더라서 여기서 멈추고, Apache 가 그 폴더의 index.php 를 연다
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /housewarming → housewarming.php 처럼 .php 를 빼고 연다
# 주소가 영문 소문자 한 단어이고 같은 이름의 .php 가 있을 때만 바꾼다
#   /housewarming /store /specialist /estimate → 각 화면
#   /login /join /logout → 헤더 모달 폼의 처리 파일, /captcha → captcha.php
# 주소 뒤의 쿼리 문자열(/captcha?123 의 123)은 바꾸지 않고 그대로 넘긴다
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-z]+)$ $1.php [L]
